diff --git a/src/av1-compat.hpp b/src/av1-compat.hpp
new file mode 100644
index 0000000..a6368e4
--- /dev/null
+++ b/src/av1-compat.hpp
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: MIT
+//
+// The installed linux/videodev2.h predates the AV1 pixel format rename: it only defines
+// V4L2_PIX_FMT_AV1_FRAME ('AV1F'). The running kernel's iris driver enumerates
+// V4L2_PIX_FMT_AV1 ('AV01'), the compressed OBU stream this decoder consumes, so define
+// it here rather than depending on a newer libc headers package.
+#pragma once
+#include <linux/videodev2.h>
+#ifndef V4L2_PIX_FMT_AV1
+#define V4L2_PIX_FMT_AV1 v4l2_fourcc('A', 'V', '0', '1') /* AV1 OBU stream */
+#endif
diff --git a/src/av1.cpp b/src/av1.cpp
new file mode 100644
index 0000000..2cf149d
--- /dev/null
+++ b/src/av1.cpp
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: MIT
+//
+// AV1 decoding for the Iris V4L2 stateful backend.
+//
+// The kernel driver exposes V4L2_PIX_FMT_AV1 ('AV01'), a compressed OBU stream, and its HFI
+// layer already implements AV1 profiles, levels, tiers, film grain and superblocks (see
+// iris_hfi_gen2_command.c). A stateful V4L2 decoder wants the temporal unit exactly as the
+// bitstream carries it.
+//
+// Unlike H.264/HEVC/VP9, VA does not deliver a picture parameter buffer for AV1: the frame
+// header and sequence header ride inside the slice data, so this is a straight passthrough
+// of the slice payload. Nothing is rewritten or stripped - AV1 uses OBU headers, not
+// Annex-B start codes.
+#include "internal.hpp"
+#include "av1-compat.hpp"
+
+namespace irisva {
+std::vector<uint8_t> av1_bitstream(VAProfile profile, const Av1Picture &picture) {
+    check(is_av1(profile), "AV1 requires an AV1 profile", VA_STATUS_ERROR_UNSUPPORTED_PROFILE);
+
+    std::vector<uint8_t> out;
+    size_t total = 0;
+    for (const auto &s : picture.slices)
+        total += s.bytes.size();
+    out.reserve(total + 16);
+
+    for (const auto &s : picture.slices) {
+        if (s.bytes.empty())
+            continue;
+        trace("AV1 slice %zu bytes (offset %u size %u flag %#x)", s.bytes.size(),
+              s.params.slice_data_offset, s.params.slice_data_size, s.params.slice_data_flag);
+        out.insert(out.end(), s.bytes.begin(), s.bytes.end());
+    }
+
+    check(!out.empty(), "AV1 produced no bitstream data", VA_STATUS_ERROR_INVALID_BUFFER);
+    trace("AV1 temporal unit: profile=%s bytes=%zu", profile == VAProfileAV1Profile1 ? "1" : "0",
+          out.size());
+    return out;
+}
+} // namespace irisva
